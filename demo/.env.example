# Railway service variables for the Craft CMS demo (set them in Railway, never commit real values).

# PostgreSQL server; the demo creates and uses the database CRAFT_DEMO_DB_NAME on it.
DATABASE_URL=${{Postgres.DATABASE_URL}}
# CRAFT_DEMO_DB_NAME=craft

# Random secret (e.g. openssl rand -hex 32). Changing it signs everyone out.
CRAFT_SECURITY_KEY=

# Demo accounts, created on every start if they don't exist yet (existing accounts are never
# changed). Log in at /admin with the e-mail address. Passwords: at least 6 characters.
# Craft is installed automatically on the first start, so there is no installer screen.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Member of the "Editors" group: articles in every site, may translate with Supertext.
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=

# Supertext (the plugin settings reference these variables)
# API key: supertext.com → Integrations → API (https://www.supertext.com/en/integrations/api, Admin role required).
# No account yet? https://www.supertext.com/person/en/account/signin
SUPERTEXT_API_KEY=
# Optional, e.g. a stand-in API: http://127.0.0.1:8765/v1/
# SUPERTEXT_API_URL=

# Set by Railway; the site's address is https://$RAILWAY_PUBLIC_DOMAIN/
# PORT=8080
# RAILWAY_PUBLIC_DOMAIN=
# Or set the address yourself:
# PRIMARY_SITE_URL=https://example.com/
