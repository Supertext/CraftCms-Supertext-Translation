{
  "name": "supertext/craft-supertext-demo",
  "description": "Demo site for Supertext Translation for Craft CMS (Railway)",
  "type": "project",
  "license": "MIT",
  "require": {
    "craftcms/ckeditor": "^5.8",
    "craftcms/cms": "~5.11.4",
    "supertext/craft-supertext-translation": "*@dev",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "repositories": [
    { "type": "path", "url": "../..", "options": { "symlink": true } }
  ],
  "autoload": {
    "psr-4": { "modules\\": "modules/" }
  },
  "config": {
    "allow-plugins": { "craftcms/plugin-installer": true, "yiisoft/yii2-composer": true },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": { "php": "8.3" }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
