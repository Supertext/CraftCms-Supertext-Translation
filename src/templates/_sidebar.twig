<fieldset class="supertext-box" data-supertext data-entry-id="{{ entryId }}" data-site-id="{{ siteId }}">
    <legend class="h6">
        <span class="supertext-logo" aria-hidden="true">S</span>
        {{ 'Translate with Supertext'|t('supertext-translation') }}
