{% import '_includes/forms' as forms %}

{{ forms.autosuggestField({
    label: 'API key'|t('supertext-translation'),
    instructions: 'No Supertext account yet? <a href="{signupUrl}" target="_blank" rel="noopener">Create one at supertext.com</a>. Generate your API key at <a href="{apiKeyUrl}" target="_blank" rel="noopener">supertext.com → Integrations → API</a> (requires the Admin role). Use an environment variable such as `$SUPERTEXT_API_KEY` so the key stays out of the project config. With or without the `Supertext-Auth-Key` prefix.'|t('supertext-translation', {
        signupUrl: 'https://www.supertext.com/person/en/account/signin',
        apiKeyUrl: 'https://www.supertext.com/en/integrations/api',
    }),
    id: 'apiKey',
    name: 'apiKey',
    value: settings.apiKey,
    suggestEnvVars: true,
    required: true,
}) }}

{{ forms.selectField({
    label: 'Supertext API'|t('supertext-translation'),
    id: 'environment',
    name: 'environment',
    value: settings.environment,
    options: [
        { value: 'live', label: 'Live (api.supertext.com)'|t('supertext-translation') },
        { value: 'staging', label: 'Staging'|t('supertext-translation') },
        { value: 'testing', label: 'Testing'|t('supertext-translation') },
    ],
}) }}

{{ forms.autosuggestField({
    label: 'Custom API address'|t('supertext-translation'),
    instructions: 'Only needed for a proxy or a test server. Overrides the choice above.'|t('supertext-translation'),
    id: 'apiUrl',
    name: 'apiUrl',
    value: settings.apiUrl,
    suggestEnvVars: true,
    placeholder: 'https://api.supertext.com/v1/',
}) }}

<div class="field" data-supertext-test>
    <div class="heading"><label>{{ 'API key check'|t('supertext-translation') }}</label></div>
    <div class="instructions"><p>{{ 'Checks the saved API key against the Supertext API. Nothing is translated or charged.'|t('supertext-translation') }}</p></div>
    <p data-supertext-test-result aria-live="polite" class="{{ check ? (check.status == 'ok' ? 'success' : 'error') : 'light' }}">
        {%- if check -%}
            {{ (check.status == 'ok' ? '✓ ' : '') }}{{ checkText|raw }}
            <span class="light" data-supertext-test-time>({{ 'checked {time}'|t('supertext-translation', { time: check.checkedAt|datetime('short') }) }})</span>
        {%- else -%}
            {{ 'Not checked yet.'|t('supertext-translation') }}
        {%- endif -%}
    </p>
    <div class="flex">
        <button type="button" class="btn" data-supertext-test-button>{{ 'Test connection'|t('supertext-translation') }}</button>
    </div>
    <p class="light">{{ 'API address in use:'|t('supertext-translation') }} <code>{{ settings.getBaseUrl() }}</code></p>
</div>

<hr>

<h2>{{ 'Languages'|t('supertext-translation') }}</h2>
<p>{{ 'Choose the Supertext language of each site: Supertext translates into it, and from it when the site is the source. The list preselects the site’s language where Supertext offers it, else its usual variant (e.g. “de” → German (Germany) de-DE, “en” → English (United States) en-US); save to keep the choice. A site marked “— choose —” has no obvious Supertext language and isn’t translated until you choose one.'|t('supertext-translation') }}</p>
{% if settings.getErrors('languages') %}
    {% include '_includes/forms/errorList' with { errors: settings.getErrors('languages') } %}
{% endif %}
<table class="data fullwidth" data-supertext-languages>
    <thead>
        <tr>
            <th>{{ 'Site'|t('app') }}</th>
            <th>{{ 'Language'|t('app') }}</th>
            <th>{{ 'Supertext language'|t('supertext-translation') }}</th>
            <th>{{ 'Form of address'|t('supertext-translation') }}</th>
        </tr>
    </thead>
    <tbody>
        {% for site in sites %}
            {% set config = settings.languages[site.handle] ?? {} %}
            {% set info = languages[site.handle] %}
            {% set options = [{ value: '', label: '— choose —'|t('supertext-translation') }] %}
            {% set known = info.code == '' %}
            {% for target in targets %}
                {% set options = options|merge([{ value: target.code, label: target.name ~ ' (' ~ target.code ~ ')', data: { politeness: target.politeness ? '1' : '0' } }]) %}
                {% if target.code == info.code %}{% set known = true %}{% endif %}
            {% endfor %}
            {% if not known %}
                {# Only a code set in config/supertext-translation.php can be outside the list: shown as it is. #}
                {% set options = options|merge([{ value: info.code, label: info.code }]) %}
            {% endif %}
            {% set showPoliteness = info.politenessSupported is not same as(false) and info.target is not null %}
            <tr data-supertext-site="{{ site.handle }}">
                <td>{{ site.name }}</td>
                <td><code>{{ site.language }}</code></td>
                <td>
                    {{ forms.selectField({
                        id: 'supertext-language-' ~ site.handle,
                        name: 'languages[' ~ site.handle ~ '][code]',
                        value: info.code,
                        options: options,
                        disabled: info.configured,
                        inputAttributes: { aria: { label: 'Supertext language'|t('supertext-translation') ~ ': ' ~ site.name }, data: { 'supertext-code': true } },
                        tip: info.configured ? 'Set in config/supertext-translation.php, which overrides this setting.'|t('supertext-translation') : null,
                    }) }}
                    {% if info.target is null %}
                        <p class="error" data-supertext-not-mapped>{{ 'Not mapped: choose a Supertext language, or this site isn’t translated.'|t('supertext-translation') }}</p>
                    {% endif %}
                </td>
                <td>
                    <div data-supertext-politeness{% if not showPoliteness %} class="hidden"{% endif %}>
                        {{ forms.select({
                            name: 'languages[' ~ site.handle ~ '][politeness]',
                            value: config.politeness ?? 'default',
                            disabled: not showPoliteness,
                            inputAttributes: { aria: { label: 'Form of address'|t('supertext-translation') ~ ': ' ~ site.name } },
                            options: [
                                { value: 'default', label: 'Default'|t('supertext-translation') },
                                { value: 'more', label: 'Formal (Sie, vous)'|t('supertext-translation') },
                                { value: 'less', label: 'Informal (du, tu)'|t('supertext-translation') },
                            ],
                        }) }}
                    </div>
                    <p class="light" data-supertext-no-politeness{% if showPoliteness or info.target is null %} hidden{% endif %}>{{ 'Not offered for this language.'|t('supertext-translation') }}</p>
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>

{{ forms.textField({
    label: 'Timeout'|t('supertext-translation'),
    instructions: 'Seconds to wait for the translation of one site.'|t('supertext-translation'),
    id: 'timeout',
    name: 'timeout',
    value: settings.timeout,
    type: 'number',
    size: 6,
}) }}

<hr>

{{ forms.lightswitchField({
    label: 'Send version information to Supertext'|t('supertext-translation'),
    instructions: 'Sends the site URL and the versions of this plugin, the CMS and the runtime to Supertext when you save these settings and after an update, so Supertext support can see which version you run. No content, no API key and no personal data are sent.'|t('supertext-translation'),
    id: 'versionReports',
    name: 'versionReports',
    on: settings.versionReports,
    warning: reportsForced ? (reportsEnabled
        ? 'SUPERTEXT_VERSION_REPORTS is set on this server: version information is sent regardless of this setting.'|t('supertext-translation')
        : 'SUPERTEXT_VERSION_REPORTS is set on this server: nothing is sent, regardless of this setting.'|t('supertext-translation')) : null,
}) }}
{% if reportsEnabled and pingUrl %}
    <p class="light">{{ 'Supertext checks that the site is reachable at:'|t('supertext-translation') }} <code>{{ pingUrl }}</code></p>
{% endif %}

{% js %}
(function () {
    // Form of address only where the chosen Supertext language offers it.
    document.querySelectorAll('[data-supertext-site]').forEach((row) => {
        const code = row.querySelector('[data-supertext-code]');
        const box = row.querySelector('[data-supertext-politeness]');
        const none = row.querySelector('[data-supertext-no-politeness]');
        const notMapped = row.querySelector('[data-supertext-not-mapped]');
        if (!code || !box || !none) {
            return;
        }
        code.addEventListener('change', () => {
            const option = code.options[code.selectedIndex];
            const offered = code.value !== '' && option?.dataset.politeness !== '0';
            box.classList.toggle('hidden', !offered);
            box.querySelector('select').disabled = !offered;
            none.hidden = offered || code.value === '';
            if (notMapped) {
                notMapped.hidden = code.value !== '';
            }
        });
    });

    const button = document.querySelector('[data-supertext-test-button]');
    const result = document.querySelector('[data-supertext-test-result]');
    button.addEventListener('click', async () => {
        button.classList.add('loading');
        try {
            const response = await Craft.sendActionRequest('POST', 'supertext-translation/translate/test-connection');
            result.className = response.data.ok ? 'success' : 'error';
            // The message is the plugin's own translated text (links included).
            result.innerHTML = (response.data.ok ? '✓ ' : '') + response.data.message;
        } catch (e) {
            result.className = 'error';
            result.textContent = e?.response?.data?.message ?? String(e);
        } finally {
            button.classList.remove('loading');
        }
    });
})();
{% endjs %}
